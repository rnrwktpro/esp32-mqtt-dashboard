<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>ESP32 GPIO Monitor</title>
  <script src="https://unpkg.com/mqtt/dist/mqtt.min.js"></script>

  <style>
    body { font-family: Arial; background:#111; color:#0f0; text-align:center; }
    .box { margin-top:50px; font-size:30px; }
    .status { font-size:18px; margin-top:10px; color:#aaa; }
  </style>
</head>
<body>

<h2>ESP32 GPIO 상태</h2>
<div class="box" id="gpio">대기중...</div>
<div class="status" id="conn">연결중...</div>

<script>
  const client = mqtt.connect(
    'wss://8ec1da5a0b454c74ad3232327ead143a.s1.eu.hivemq.cloud:8884/mqtt',
    {
      username: 'esp32_1',
      password: '!Rlaguscjf1',
      reconnectPeriod: 2000
    }
  );

  client.on('connect', () => {
    document.getElementById('conn').innerText = 'MQTT 연결됨';
    client.subscribe('esp32/#');
  });

  client.on('message', (topic, message) => {
    if (topic === 'esp32/gpio/13') {
      document.getElementById('gpio').innerText =
        'GPIO13 = ' + message.toString();
    }
  });

  client.on('error', err => {
    document.getElementById('conn').innerText = '연결 오류';
    console.error(err);
  });
</script>

</body>
</html>
